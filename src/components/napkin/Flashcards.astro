---
type Flash = { kind: 'qa'; q: string; a: string } | { kind: 'cloze'; text: string };
interface Props {
  cards: Flash[];
}
const { cards } = Astro.props;
const segs = (text: string) =>
  text
    .split(/(\{\{[^}]+\}\})/g)
    .filter(Boolean)
    .map((p) => (p.startsWith('{{') ? { blank: p.slice(2, -2) } : { text: p }));
---

<ol class="fc-list">
  {
    cards.map((c, i) => (
      <li class="fc" data-flip>
        <button class="fc__inner" type="button" aria-expanded="false" aria-label={`Card ${i + 1}: reveal the answer`}>
          <span class="fc__face fc__front">
            <span class="fc__tag mono">{c.kind === 'qa' ? 'Q' : 'Fill the blank'}</span>
            <span class="fc__q">
              {c.kind === 'qa'
                ? c.q
                : segs(c.text).map((s) => ('blank' in s ? <span class="fc__blank"><span class="sr-only">blank</span>____</span> : s.text))}
            </span>
            <span class="fc__cta">Tap to reveal</span>
          </span>
          <span class="fc__face fc__back" aria-hidden="true">
            <span class="fc__tag mono">A</span>
            <span class="fc__a">
              {c.kind === 'qa' ? c.a : segs(c.text).map((s) => ('blank' in s ? <mark>{s.blank}</mark> : s.text))}
            </span>
            <span class="fc__cta">Tap to hide</span>
          </span>
        </button>
      </li>
    ))
  }
</ol>

<script>
  for (const li of document.querySelectorAll<HTMLElement>('[data-flip]')) {
    const b = li.querySelector('button');
    const front = li.querySelector('.fc__front');
    const back = li.querySelector('.fc__back');
    b?.addEventListener('click', () => {
      const open = li.toggleAttribute('data-open');
      b.setAttribute('aria-expanded', String(open));
      front?.setAttribute('aria-hidden', String(open));
      back?.setAttribute('aria-hidden', String(!open));
    });
  }
</script>

<style>
  .fc-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .fc {
    perspective: 1200px;
  }
  .fc__inner {
    position: relative;
    display: grid;
    width: 100%;
    min-height: 190px;
    text-align: left;
    transform-style: preserve-3d;
    transition: transform var(--dur-slow) var(--ease-flip);
  }
  .fc[data-open] .fc__inner {
    transform: rotateY(180deg);
  }
  .fc__face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-1);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .fc__back {
    transform: rotateY(180deg);
    background: var(--track-soft, var(--surface-2));
  }
  .fc__inner:hover .fc__face {
    border-color: var(--border-strong);
  }
  .fc__tag {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--track-ink, var(--accent-ink));
    text-transform: uppercase;
  }
  .fc__q {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.12rem;
    line-height: 1.35;
  }
  .fc__a {
    font-size: var(--text-base);
    line-height: 1.55;
  }
  .fc__a mark {
    background: var(--hl);
    color: var(--hl-ink);
    padding: 0 3px;
    border-radius: 4px;
    font-weight: 700;
  }
  .fc__blank {
    display: inline-block;
    min-width: 3.2em;
    border-bottom: 2.5px solid var(--track, var(--ink));
    color: transparent;
    line-height: 1;
  }
  .fc__cta {
    margin-top: auto;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html:not([data-motion='full'])) .fc__inner {
      transition: none;
    }
  }
  :global(html[data-motion='reduced']) .fc__inner {
    transition: none;
  }
</style>
