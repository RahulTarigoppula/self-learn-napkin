---
interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 30, wordmark = true } = Astro.props;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <path
      class="logo__paper"
      d="M5.2 6.6c0-.9.8-1.6 1.7-1.6l18.4.5c.9 0 1.6.8 1.6 1.7l-.3 13.5-6.6 6.5-13.2-.3c-.9 0-1.6-.8-1.6-1.7z"
    ></path>
    <path class="logo__fold" d="M26.6 20.7l-5.4.2c-.7 0-1.2.6-1.2 1.2l.2 5"></path>
    <path class="logo__ink" d="M9.6 16.2c1.6-3.4 3.6-3.6 5-.6 1.3 2.8 3.3 3 5.6-.9"></path>
    <circle class="logo__dot" cx="21.6" cy="11" r="1.7"></circle>
  </svg>
  {wordmark && <span class="logo__word">napkin</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .logo__paper {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .logo__fold {
    fill: var(--surface-3);
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .logo__ink {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .logo__dot {
    fill: var(--dsa);
  }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.32rem;
    letter-spacing: -0.035em;
    line-height: 1;
  }
</style>
