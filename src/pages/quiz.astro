---
import QuickQuiz from '../features/quiz/QuickQuiz';
import AppShell from '../layouts/AppShell.astro';
---

<AppShell title="Quick quiz" active="quiz" description="A mixed round of interview questions across every napkin, with an explanation for each answer.">
  <div class="container quiz-page">
    <header class="quiz-intro">
      <p class="eyebrow">Mixed practice</p>
      <h1>Quick quiz</h1>
      <p class="muted">A shuffled round across topics, which is the closest thing to an interviewer picking at random. Every answer comes with the reason.</p>
    </header>
    <QuickQuiz client:load />
  </div>
</AppShell>

<style>
  .quiz-page {
    padding-top: var(--space-6);
  }
  /* Left-aligned with every other page; only the reading width is capped. */
  .quiz-page > :global(*) {
    max-width: 760px;
  }
  .quiz-intro {
    margin: 0 0 var(--space-6);
  }
  .quiz-intro h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: var(--space-2) 0;
  }
  /* During a round the intro steps aside; the heading stays for screen readers. */
  .quiz-page:global(.is-playing) {
    padding-top: var(--space-4);
  }
  .quiz-page:global(.is-playing) .quiz-intro {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    margin: 0;
  }
</style>
