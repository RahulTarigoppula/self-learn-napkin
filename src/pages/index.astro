---
import Icon from '../components/Icon.astro';
import NapkinTile from '../components/NapkinTile.astro';
import HomeDashboard from '../features/home/HomeDashboard';
import AppShell from '../layouts/AppShell.astro';
import { cardHref, href, withBase } from '../lib/base';
import { library, numberOf } from '../lib/content';
import { inlineMd } from '../lib/inline-md';
import { PATHS } from '../lib/paths';

const { cards, tracks } = await library();
// Today's picks rotate daily through the hands-on napkins; the specials show first without JS.
const picks = [
  ...cards.filter((c) => c.data.special),
  ...cards.filter((c) => c.data.griddle && !c.data.special),
];
const lite = cards.map((c) => ({
  id: c.id,
  title: c.data.title,
  track: c.data.track,
  number: numberOf(c.id),
  minutes: c.data.minutes,
}));
const ids = new Set(cards.map((c) => c.id));
const paths = PATHS.map((p) => ({ ...p, ids: p.ids.filter((i) => ids.has(i)) })).filter(
  (p) => p.ids.length > 0,
);
const totalMinutes = cards.reduce((s, c) => s + c.data.minutes, 0);
// Each napkin's TL;DR is a self-contained fact for the "Did you know?" card.
const facts = cards.map((c) => ({
  id: c.id,
  t: c.data.title,
  k: c.data.track,
  f: c.data.tldr,
}));
const firstFact = facts[0];
---

<AppShell title="Napkin" active="home">
  <div class="container home">
    <section class="hero reveal">
      <div class="hero__copy">
        <p class="hero__kicker hand">interview prep, sketched on a napkin</p>
        <h1 class="hero__title">Hard ideas, <span class="hero__scribble">drawn simply</span>.</h1>
        <p class="hero__sub">
          {cards.length} hand-drawn visual stories across algorithms, system design and machine learning — each one
          builds the picture step by step, goes deep when you want it, then quizzes you until it sticks. Free, private and
          it works offline.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary btn--lg" href={href('library/')}><Icon name="library" /> Browse the library</a>
          <a class="btn btn--lg" href={href('review/')}><Icon name="layers" /> Review cards</a>
        </div>
      </div>
      <HomeDashboard client:load cards={lite} tracks={tracks.map((t) => ({ id: t.id, total: t.cards.length }))} />
    </section>

    {
      firstFact && (
        <section class="dyk card" aria-live="polite" data-facts={JSON.stringify(facts)}>
          <span class="dyk__icon" aria-hidden="true">
            <Icon name="bulb" size={22} />
          </span>
          <div class="dyk__body">
            <p class="dyk__label hand">Did you know?</p>
            <p class="dyk__fact" set:html={inlineMd(firstFact.f)} />
            <a class="dyk__link" href={cardHref(firstFact.id)}>
              From <span>{firstFact.t}</span> <Icon name="arrowRight" size={14} />
            </a>
          </div>
          <button class="btn btn--ghost btn--icon dyk__next" type="button" aria-label="Show another fact">
            <Icon name="shuffle" size={18} />
          </button>
        </section>
      )
    }

    {
      picks.length > 0 && (
        <section class="block">
          <div class="section-head">
            <div>
              <p class="eyebrow">Hands on · new picks every day</p>
              <h2>Today's picks</h2>
            </div>
            <a class="btn btn--ghost" href={href('library/')}>
              All napkins <Icon name="arrowRight" />
            </a>
          </div>
          <div class="grid3" data-picks>
            {picks.map((c, i) => (
              <div class="pick" hidden={i >= 3}>
                <NapkinTile card={c} index={i % 3} />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="block">
      <div class="section-head">
        <div>
          <p class="eyebrow">Three tracks</p>
          <h2>Pick a course</h2>
        </div>
      </div>
      <div class="tracks">
        {
          tracks.map((t, i) => (
            <a class:list={['track', `t-${t.id}`, 'reveal']} href={href(`${t.id}/`)} style={`--d:${i}`}>
              <span class="track__name hand">{t.name}</span>
              <span class="track__subtitle">{t.subtitle}</span>
              <span class="track__blurb">{t.blurb}</span>
              <span class="track__meter" aria-hidden="true">
                <span data-track-bar={t.id} />
              </span>
              <span class="track__foot">
                <span>
                  <b data-track-read={t.id}>0</b> / {t.cards.length} read
                </span>
                <span class="track__go">
                  Open <Icon name="arrowRight" size={16} />
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    {
      paths.length > 0 && (
        <section class="block">
          <div class="section-head">
            <div>
              <p class="eyebrow">Guided</p>
              <h2>Learning paths</h2>
            </div>
          </div>
          <div class="paths">
            {paths.map((p, i) => (
              <a class="path card reveal" href={href(`paths/${p.id}/`)} style={`--d:${i}`}>
                <span class="path__icon">
                  <Icon name={p.icon} size={22} />
                </span>
                <span class="path__title">{p.title}</span>
                <span class="path__blurb">{p.blurb}</span>
                <span class="path__meta mono">
                  {p.ids.length} napkins · <span data-path-done={p.ids.join(',')}>0</span> done
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="block">
      <div class="section-head">
        <div>
          <p class="eyebrow">Practice</p>
          <h2>Test yourself, your way</h2>
        </div>
      </div>
      <div class="practice">
        <a class="practice__item card" href={href('review/')}>
          <span class="practice__icon"><Icon name="layers" size={22} /></span>
          <span class="practice__title">Spaced review</span>
          <span class="practice__text">Flashcards scheduled by FSRS — a few minutes a day keeps everything fresh.</span>
        </a>
        <a class="practice__item card" href={href('quiz/')}>
          <span class="practice__icon"><Icon name="target" size={22} /></span>
          <span class="practice__title">Quick quiz</span>
          <span class="practice__text">A mixed round of multiple-choice questions across every topic, with explanations.</span>
        </a>
        <a class="practice__item card" href={href('cheatsheet/')}>
          <span class="practice__icon"><Icon name="library" size={22} /></span>
          <span class="practice__title">Cheat sheet</span>
          <span class="practice__text">Every key idea and complexity table on one printable page.</span>
        </a>
      </div>
    </section>

    <section class="block why card">
      <div class="why__art">
        <img src={withBase('thumbs/journey.svg')} alt="" width="520" height="320" loading="lazy" decoding="async" />
      </div>
      <div class="why__copy">
        <p class="eyebrow">Why Napkin exists</p>
        <h2>From tester, to payments in C++, to Python, data science, system design and AI.</h2>
        <p class="muted">
          “Every hard idea I understood, I understood the moment someone drew it. Napkin is the notebook I wish I’d had at
          each of those stops — simple pictures, checked facts, no superstition.”
        </p>
        <p class="why__by hand">— Rahul, Senior Software Engineer (AI)</p>
        <a class="btn" href={href('about/')}>Read the story <Icon name="arrowRight" /></a>
      </div>
    </section>

    <section class="block how">
      <div class="section-head">
        <div>
          <p class="eyebrow">How Napkin works</p>
          <h2>Learn it once. Keep it for good.</h2>
        </div>
      </div>
      <ol class="how__steps">
        <li>
          <span class="how__icon"><Icon name="play" size={20} /></span>
          <h3>Watch it drawn</h3>
          <p>Every topic is a short story. The sketch draws itself one scene at a time, so you see the idea form.</p>
        </li>
        <li>
          <span class="how__icon"><Icon name="library" size={20} /></span>
          <h3>Go deep</h3>
          <p>A full explanation follows: a worked example, clean code, the pitfalls, and what interviewers listen for.</p>
        </li>
        <li>
          <span class="how__icon"><Icon name="hand" size={20} /></span>
          <h3>Play with it</h3>
          <p>Drag servers around a ring, race BFS against DFS, push a learning rate until it explodes.</p>
        </li>
        <li>
          <span class="how__icon"><Icon name="cards" size={20} /></span>
          <h3>Make it stick</h3>
          <p>Quizzes check understanding; FSRS spaced repetition brings each card back just before you'd forget it.</p>
        </li>
      </ol>
      <p class="how__foot muted">
        {cards.length} napkins · about {Math.round(totalMinutes / 60)} hours of reading · no account, no tracking — your
        progress never leaves this device.
      </p>
    </section>
  </div>
</AppShell>

<script>
  import { lastStats, type ShellStats } from '../features/shell/shell';
  import { cardHref } from '../lib/base';
  import { inlineMd } from '../lib/inline-md';

  // "Did you know?": a random key idea each visit, and another on every shuffle.
  const dyk = document.querySelector<HTMLElement>('.dyk');
  if (dyk) {
    const facts = JSON.parse(dyk.dataset.facts ?? '[]') as { id: string; t: string; k: string; f: string }[];
    const show = () => {
      const x = facts[Math.floor(Math.random() * facts.length)];
      if (!x) return;
      const p = dyk.querySelector('.dyk__fact');
      const a = dyk.querySelector<HTMLAnchorElement>('.dyk__link');
      if (p) p.innerHTML = inlineMd(x.f);
      if (a) {
        a.href = cardHref(x.id);
        const span = a.querySelector('span');
        if (span) span.textContent = x.t;
      }
      dyk.classList.remove('is-new');
      void dyk.offsetWidth;
      dyk.classList.add('is-new');
    };
    show();
    dyk.querySelector('.dyk__next')?.addEventListener('click', show);
  }

  // Today's picks: a stable daily rotation of the hands-on napkins, unread ones first.
  const pickSlots = [...document.querySelectorAll<HTMLElement>('[data-picks] .pick')];
  const choosePicks = (read: Set<string>) => {
    const day = Math.floor((Date.now() - new Date().getTimezoneOffset() * 60_000) / 86_400_000);
    const order = pickSlots
      .map((el, i) => ({ el, i, slug: el.querySelector<HTMLElement>('[data-slug]')?.dataset.slug ?? '' }))
      .sort((a, b) => Number(read.has(a.slug)) - Number(read.has(b.slug)) || ((a.i - day) % pickSlots.length + pickSlots.length) % pickSlots.length - ((b.i - day) % pickSlots.length + pickSlots.length) % pickSlots.length);
    const show = new Set(order.slice(0, 3).map((o) => o.el));
    const grid = pickSlots[0]?.parentElement;
    for (const o of order) {
      o.el.hidden = !show.has(o.el);
      grid?.append(o.el);
    }
  };
  choosePicks(new Set());

  const paint = (s: ShellStats | null) => {
    if (!s) return;
    choosePicks(s.read);
    for (const el of document.querySelectorAll<HTMLElement>('[data-track-read]')) {
      const t = el.dataset.trackRead;
      const n = [...s.read].filter((id) => id.startsWith(`${t}/`)).length;
      el.textContent = String(n);
      const bar = document.querySelector<HTMLElement>(`[data-track-bar="${t}"]`);
      const total = Number(el.parentElement?.textContent?.match(/\/\s*(\d+)/)?.[1] ?? '1');
      if (bar) bar.style.width = `${Math.round((n / total) * 100)}%`;
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-path-done]')) {
      const ids = (el.dataset.pathDone ?? '').split(',');
      el.textContent = String(ids.filter((i) => s.read.has(i)).length);
    }
  };
  paint(lastStats());
  document.addEventListener('napkin:stats', (e) => paint((e as CustomEvent<ShellStats>).detail));
</script>

<style>
  .home {
    padding-top: var(--space-6);
  }
  .hero {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    padding: var(--space-4) 0 var(--space-2);
  }
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1.2fr) minmax(320px, 1fr);
      padding-top: var(--space-8);
    }
  }
  .hero__kicker {
    font-size: 1.25rem;
    color: var(--accent-ink);
    transform: rotate(-1.5deg);
    display: inline-block;
  }
  .hero__copy {
    container-type: inline-size;
    min-width: 0;
  }
  .hero__title {
    margin-top: var(--space-3);
    font-size: clamp(2.3rem, 12.5cqi, 4.6rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .hero__scribble {
    position: relative;
    white-space: nowrap;
  }
  .hero__scribble::after {
    content: '';
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: 0.02em;
    height: 0.34em;
    z-index: -1;
    background: color-mix(in srgb, var(--hl) 75%, transparent);
    border-radius: 40% 60% 55% 45% / 60% 40% 60% 40%;
    transform: rotate(-1.2deg);
  }
  .hero__sub {
    margin-top: var(--space-5);
    font-size: clamp(1.05rem, 2.2vw, 1.22rem);
    color: var(--ink-muted);
    max-width: 56ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .block {
    margin-top: var(--space-10);
  }
  .dyk {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-5);
    background:
      radial-gradient(80% 140% at 0% 0%, color-mix(in srgb, var(--hl) 22%, transparent), transparent 60%),
      var(--surface);
  }
  .dyk__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--hl);
    color: var(--hl-ink);
  }
  .dyk__label {
    font-size: 1.2rem;
    color: var(--accent-ink);
    line-height: 1.2;
  }
  .dyk__fact {
    font-size: clamp(1.02rem, 0.9rem + 0.6vw, var(--text-lg));
    font-weight: 500;
    margin: 4px 0 6px;
  }
  .dyk__fact :global(code) {
    font-size: 0.88em;
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--surface-2);
  }
  .dyk__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 32px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
  }
  .dyk__link span {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .dyk.is-new .dyk__body {
    animation: fade-up var(--dur-slow) var(--ease-out) both;
  }
  .block h2 {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
  }
  .pick {
    display: grid;
  }
  .grid3 {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .tracks {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 860px) {
    .tracks {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .track {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--track) 22%, transparent), transparent 60%),
      var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-1);
    overflow: hidden;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .track:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-3);
  }
  .track__name {
    font-size: 1.15rem;
    color: var(--track-ink);
  }
  .track__subtitle {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .track__blurb {
    flex: 1;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .track__meter {
    margin-top: var(--space-4);
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--surface-2);
    overflow: hidden;
  }
  .track__meter span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--track);
    border-radius: inherit;
    transition: width var(--dur-slow) var(--ease-out);
  }
  .track__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .track__foot b {
    font-family: var(--font-mono);
    color: var(--ink);
  }
  .track__go {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
    color: var(--track-ink);
  }
  .paths {
    display: grid;
    gap: var(--space-4);
  }
  /* four paths: a tidy 2 × 2, never 3 + 1 */
  @container main (min-width: 600px) {
    .paths {
      grid-template-columns: 1fr 1fr;
    }
  }
  .path {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .path:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
  }
  .path__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .path__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    margin-top: var(--space-2);
  }
  .path__blurb {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    flex: 1;
  }
  .path__meta {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }
  .practice {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .practice__item {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .practice__item:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
  }
  .practice__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--hl);
    color: var(--hl-ink);
  }
  .practice__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
  }
  .practice__text {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .why {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
    align-items: center;
    overflow: hidden;
  }
  @media (min-width: 860px) {
    .why {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      padding: var(--space-8);
    }
  }
  .why__art {
    border-radius: var(--radius-lg);
    padding: var(--space-3);
    background-color: var(--thumb-paper);
    background-image:
      linear-gradient(var(--thumb-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--thumb-grid) 1px, transparent 1px);
    background-size: 18px 18px;
    transform: rotate(-1deg);
  }
  .why__art img {
    width: 100%;
    height: auto;
  }
  .why__copy {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .why__copy h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
  }
  .why__copy .muted {
    font-size: var(--text-md);
  }
  .why__by {
    font-size: 1.2rem;
    color: var(--accent-ink);
  }
  .how__steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    counter-reset: step;
  }
  .how__steps li {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--border-strong);
  }
  .how__steps h3 {
    font-size: var(--text-lg);
    margin: var(--space-3) 0 var(--space-1);
  }
  .how__steps p {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .how__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
  }
  .how__foot {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }
</style>
