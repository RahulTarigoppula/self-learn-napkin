{
  "name": "napkin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interview prep sketched on the back of a diner napkin. Offline-first visual study cards for DSA, System Design and Data Science.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "diagrams": "node scripts/build-diagrams.mjs",
    "decks": "node scripts/build-decks.mjs",
    "fonts": "python scripts/subset-fonts.py",
    "icons": "node scripts/make-icons.mjs",
    "number": "node scripts/number-card.mjs",
    "build": "node scripts/lint-licences.mjs && npm run decks && astro build && node scripts/build-sw.mjs && node scripts/check-budgets.mjs",
    "preview": "astro preview",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "node scripts/lint-licences.mjs && astro check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:build": "vitest run --project build",
    "test:e2e": "playwright test --project=desktop --project=pixel7",
    "test:a11y": "playwright test --project=a11y",
    "test:offline": "playwright test --project=offline",
    "test:python": "node scripts/check-python.mjs",
    "test:licences": "license-checker-rseidelsohn --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;MPL-2.0;0BSD;CC0-1.0;Unlicense;OFL-1.1;Python-2.0;BlueOak-1.0.0;CC-BY-4.0\" --production --excludePrivatePackages --excludePackagesStartingWith @img/sharp --summary"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.6",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "astro": "^7.3.8",
    "dexie": "^4.4.6",
    "preact": "^10.29.8",
    "roughjs": "^4.6.6",
    "ts-fsrs": "^5.4.2",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "jsdom": "^27.4.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "svgo": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "workbox-build": "^7.4.1",
    "yaml": "^2.9.1"
  }
}
