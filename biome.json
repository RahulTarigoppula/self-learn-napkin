{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/android",
      "!**/public/diagrams",
      "!**/public/decks",
      "!**/src/generated",
      "!**/src/features/receipt/mono-font.ts",
      "!**/design",
      "!**/docs",
      "!**/.astro",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/public/thumbs",
      "!**/public/icons",
      "!**/tests/fixtures",
      "!**/src/diagrams",
      "!**/.secrets",
      "!**/resources",
      "!**/.claude"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" },
    "jsxRuntime": "transparent"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "style": { "noNonNullAssertion": "off" },
      "a11y": {
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off"
      },
      "suspicious": { "noArrayIndexKey": "off" },
      "complexity": { "noImportantStyles": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" },
          "style": { "useConst": "off", "useImportType": "off" }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
